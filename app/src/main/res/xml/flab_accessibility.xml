<?xml version="1.0" encoding="utf-8"?>
<!--
    Deliberately the narrowest configuration that can answer "which app is in front".

    Absent, and absent on purpose:
      android:canRetrieveWindowContent  — F/LAB never reads screen content.
      android:canPerformGestures        — F/LAB never acts for the user.
      android:canRequestFilterKeyEvents — F/LAB never sees keystrokes.
      android:packageNames              — unset means "all packages", which is required: the whole
                                          point is to recognise a bank in front so the overlay can
                                          stand down. A filtered list would blind exactly the check
                                          that protects the user.

    accessibilityEventTypes is a single event type, not typeAllMask.
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagDefault"
    android:description="@string/accessibility_description"
    android:notificationTimeout="100"
    android:settingsActivity="com.lquiroz.flab.MainActivity"
    android:summary="@string/accessibility_summary" />
