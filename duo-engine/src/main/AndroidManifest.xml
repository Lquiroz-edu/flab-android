<manifest xmlns:android="http://schemas.android.com/apk/res/android">
 <uses-permission android:name="moe.shizuku.manager.permission.API_V23" />
 <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
 <uses-permission android:name="android.permission.SET_WALLPAPER" />
 <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
 <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
 <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
 <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
 <uses-feature android:name="android.hardware.sensor.hinge_angle" android:required="false" />
 <queries>
  <intent>
   <action android:name="android.intent.action.MAIN" />
   <category android:name="android.intent.category.HOME" />
  </intent>
  <package android:name="moe.shizuku.privileged.api" />
  <intent>
   <action android:name="android.service.wallpaper.WallpaperService" />
  </intent>
  <package android:name="com.samsung.android.wallpaper.live" />
  <package android:name="com.samsung.android.wallpaper.res" />
 </queries>
 <uses-permission android:name="android.permission.WAKE_LOCK" />
 <application android:hardwareAccelerated="true">
  <provider android:name="androidx.core.content.FileProvider" android:authorities="${applicationId}.files" android:exported="false" android:grantUriPermissions="true">
   <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/export_paths" />
  </provider>
  <meta-data android:name="moe.shizuku.client.V3_SUPPORT" android:value="true" />
  <provider android:name="rikka.shizuku.ShizukuProvider" android:authorities="${applicationId}.shizuku" android:exported="true" android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />
  <receiver android:name="org.duofold.live.SupportReminderReceiver" android:exported="false" />
  <receiver android:name="org.duofold.live.RestoreReceiver" android:exported="false">
   <intent-filter>
    <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
    <action android:name="android.intent.action.BOOT_COMPLETED" />
   </intent-filter>
  </receiver>
  <activity android:name="org.duofold.live.MainActivity" android:exported="false" android:resizeableActivity="true" android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation|density" android:theme="@style/Theme.Standalone">
   </activity>
  <activity android:name="org.duofold.live.SetupActivity" android:exported="false" android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation|density" android:theme="@style/Theme.Standalone" />
  <activity android:name="org.duofold.live.FoldBridgeActivity" android:exported="false" android:theme="@style/Theme.Duo.FoldBridge" android:taskAffinity="org.duofold.live.foldbridge" android:excludeFromRecents="true" android:noHistory="true" android:resizeableActivity="true" android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation|density" />
  <activity android:name="org.duofold.live.FoldProbeActivity" android:exported="false" android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation|density" android:theme="@style/Theme.Standalone" />
  <activity android:name="org.duofold.live.FoldMotionActivity" android:exported="false" android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation|density" android:theme="@style/Theme.Standalone" />
  <service android:name="org.duofold.live.FoldBackgroundService" android:exported="false" android:stopWithTask="false" android:foregroundServiceType="specialUse">
   <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE" android:value="Persistent fold keep-awake setting supervision, hinge animation overlay and wallpaper-angle reader" />
  </service>
  <service android:name="org.duofold.live.StandaloneService" android:label="F/LAB · Duo Global" android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE" android:exported="true">
   <intent-filter>
    <action android:name="android.accessibilityservice.AccessibilityService" />
   </intent-filter>
   <meta-data android:name="android.accessibilityservice" android:resource="@xml/accessibility" />
  </service>
  <activity android:name="org.duofold.live.wallpaperlayer.WallpaperActivity" android:exported="false" android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout" android:theme="@style/Theme.Standalone" />
 </application>
 <instrumentation android:name="org.duofold.live.wallpaperlayer.PhotoInstrumentation" android:targetPackage="${applicationId}" android:functionalTest="true" android:label="Custom wallpaper host" />
</manifest>